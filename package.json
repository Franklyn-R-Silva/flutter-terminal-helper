{
  "name": "flutter-terminal-helper",
  "displayName": "Flutter Terminal Helper",
  "description": "%ext.description%",
  "version": "0.6.0",
  "l10n": "./l10n",
  "publisher": "Franklyn-R-Silva",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#0B1622",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Franklyn-R-Silva/flutter-terminal-helper.git"
  },
  "bugs": {
    "url": "https://github.com/Franklyn-R-Silva/flutter-terminal-helper/issues"
  },
  "homepage": "https://github.com/Franklyn-R-Silva/flutter-terminal-helper#readme",
  "keywords": [
    "flutter",
    "dart",
    "terminal",
    "cli",
    "commands",
    "sidebar",
    "productivity",
    "helper",
    "fvm",
    "melos",
    "supabase",
    "firebase",
    "riverpod",
    "getx",
    "favorites",
    "mobile"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other",
    "Snippets"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.untrusted.desc%",
      "restrictedConfigurations": [
        "flutterHelper.customCommands",
        "flutterHelper.clickAction"
      ]
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "flutter-helper",
          "title": "Flutter Helper",
          "icon": "images/activitybar.svg"
        }
      ]
    },
    "views": {
      "flutter-helper": [
        {
          "id": "flutterCommands",
          "name": "%view.flutterCommands.name%",
          "icon": "images/activitybar.svg",
          "contextualTitle": "Flutter Helper"
        }
      ]
    },
    "commands": [
      {
        "command": "flutterHelper.pasteFromTree",
        "title": "%cmd.paste.title%",
        "category": "Flutter Helper",
        "icon": "$(clippy)"
      },
      {
        "command": "flutterHelper.runFromTree",
        "title": "%cmd.run.title%",
        "category": "Flutter Helper",
        "icon": "$(play)"
      },
      {
        "command": "flutterHelper.copyCommand",
        "title": "%cmd.copy.title%",
        "category": "Flutter Helper",
        "icon": "$(copy)"
      },
      {
        "command": "flutterHelper.refreshCommands",
        "title": "%cmd.refresh.title%",
        "category": "Flutter Helper",
        "icon": "$(refresh)"
      },
      {
        "command": "flutterHelper.searchCommands",
        "title": "%cmd.search.title%",
        "category": "Flutter Helper",
        "icon": "$(search)"
      },
      {
        "command": "flutterHelper.addFavorite",
        "title": "%cmd.addFavorite.title%",
        "category": "Flutter Helper",
        "icon": "$(star-empty)"
      },
      {
        "command": "flutterHelper.removeFavorite",
        "title": "%cmd.removeFavorite.title%",
        "category": "Flutter Helper",
        "icon": "$(star-full)"
      },
      {
        "command": "flutterHelper.clearRecent",
        "title": "%cmd.clearRecent.title%",
        "category": "Flutter Helper",
        "icon": "$(clear-all)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "flutterHelper.pasteFromTree",
          "when": "false"
        },
        {
          "command": "flutterHelper.runFromTree",
          "when": "false"
        },
        {
          "command": "flutterHelper.copyCommand",
          "when": "false"
        },
        {
          "command": "flutterHelper.addFavorite",
          "when": "false"
        },
        {
          "command": "flutterHelper.removeFavorite",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "flutterHelper.searchCommands",
          "when": "view == flutterCommands",
          "group": "navigation@1"
        },
        {
          "command": "flutterHelper.refreshCommands",
          "when": "view == flutterCommands",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "flutterHelper.runFromTree",
          "when": "view == flutterCommands && viewItem =~ /^command/",
          "group": "inline@1"
        },
        {
          "command": "flutterHelper.addFavorite",
          "when": "view == flutterCommands && viewItem == command",
          "group": "inline@2"
        },
        {
          "command": "flutterHelper.removeFavorite",
          "when": "view == flutterCommands && viewItem == commandFavorite",
          "group": "inline@2"
        },
        {
          "command": "flutterHelper.copyCommand",
          "when": "view == flutterCommands && viewItem =~ /^command/",
          "group": "inline@3"
        },
        {
          "command": "flutterHelper.runFromTree",
          "when": "view == flutterCommands && viewItem =~ /^command/",
          "group": "1_actions@1"
        },
        {
          "command": "flutterHelper.pasteFromTree",
          "when": "view == flutterCommands && viewItem =~ /^command/",
          "group": "1_actions@2"
        },
        {
          "command": "flutterHelper.copyCommand",
          "when": "view == flutterCommands && viewItem =~ /^command/",
          "group": "1_actions@3"
        },
        {
          "command": "flutterHelper.addFavorite",
          "when": "view == flutterCommands && viewItem == command",
          "group": "2_favorite@1"
        },
        {
          "command": "flutterHelper.removeFavorite",
          "when": "view == flutterCommands && viewItem == commandFavorite",
          "group": "2_favorite@1"
        },
        {
          "command": "flutterHelper.clearRecent",
          "when": "view == flutterCommands && viewItem == recentCategory",
          "group": "inline@1"
        }
      ]
    },
    "configuration": {
      "title": "Flutter Terminal Helper",
      "properties": {
        "flutterHelper.clickAction": {
          "type": "string",
          "enum": [
            "paste",
            "run"
          ],
          "enumDescriptions": [
            "%config.clickAction.paste%",
            "%config.clickAction.run%"
          ],
          "default": "paste",
          "description": "%config.clickAction.desc%"
        },
        "flutterHelper.terminalName": {
          "type": "string",
          "default": "Flutter",
          "description": "%config.terminalName.desc%"
        },
        "flutterHelper.reuseTerminal": {
          "type": "boolean",
          "default": true,
          "description": "%config.reuseTerminal.desc%"
        },
        "flutterHelper.customCommands": {
          "type": "array",
          "default": [],
          "markdownDescription": "%config.customCommands.desc%",
          "items": {
            "type": "object",
            "required": [
              "label",
              "command"
            ],
            "properties": {
              "label": {
                "type": "string",
                "description": "%config.customCommands.label%"
              },
              "command": {
                "type": "string",
                "description": "%config.customCommands.command%"
              },
              "description": {
                "type": "string",
                "description": "%config.customCommands.description%"
              }
            }
          }
        },
        "flutterHelper.promptForArguments": {
          "type": "boolean",
          "default": true,
          "description": "%config.promptForArguments.desc%"
        },
        "flutterHelper.useFvm": {
          "type": "string",
          "enum": [
            "auto",
            "on",
            "off"
          ],
          "enumDescriptions": [
            "%config.useFvm.auto%",
            "%config.useFvm.on%",
            "%config.useFvm.off%"
          ],
          "default": "auto",
          "description": "%config.useFvm.desc%"
        },
        "flutterHelper.recentLimit": {
          "type": "number",
          "default": 8,
          "minimum": 0,
          "maximum": 50,
          "description": "%config.recentLimit.desc%"
        }
      }
    },
    "keybindings": [
      {
        "command": "flutterHelper.searchCommands",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f"
      }
    ],
    "walkthroughs": [
      {
        "id": "flutterHelperGettingStarted",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "openSidebar",
            "title": "%walkthrough.open.title%",
            "description": "%walkthrough.open.description%",
            "media": {
              "markdown": "media/walkthroughs/open.md"
            }
          },
          {
            "id": "search",
            "title": "%walkthrough.search.title%",
            "description": "%walkthrough.search.description%",
            "media": {
              "markdown": "media/walkthroughs/search.md"
            },
            "completionEvents": [
              "onCommand:flutterHelper.searchCommands"
            ]
          },
          {
            "id": "customize",
            "title": "%walkthrough.customize.title%",
            "description": "%walkthrough.customize.description%",
            "media": {
              "markdown": "media/walkthroughs/customize.md"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package:build",
    "compile": "tsc -p ./",
    "watch": "tsc -w",
    "check-types": "tsc --noEmit -p ./",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package:build": "node esbuild.mjs --production",
    "esbuild": "node esbuild.mjs",
    "esbuild:watch": "node esbuild.mjs --watch",
    "pretest": "npm run compile && npm run package:build",
    "test": "vscode-test",
    "icon": "node scripts/generate-icon.js",
    "package": "vsce package --no-dependencies",
    "publish:ovsx": "ovsx publish --no-dependencies",
    "version:patch": "npm version patch -m \"chore: release v%s\"",
    "version:minor": "npm version minor -m \"chore: release v%s\"",
    "version:major": "npm version major -m \"chore: release v%s\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.1",
    "@types/vscode": "1.80.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "mocha": "^11.7.6",
    "ovsx": "^0.10.1",
    "prettier": "^3.9.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0"
  }
}
